import pygame
import sys
import threading
import random
import time
import numpy as np
import os
import subprocess
from config import *

class SpeechManager:
    def __init__(self, face):
        self.face = face
        self.is_talking = False
        self.current_word = ""
        self.full_text = ""
        self._lock = threading.Lock()
        
        # Platform detection
        self.platform = sys.platform
        if self.platform == "darwin": # macOS
            self.temp_file = "speech_temp.aiff"
            self.save_cmd = ['say', '-o']
            self.play_cmd = ['/usr/bin/afplay']
        elif self.platform == "linux": # Ubuntu/Raspberry Pi
            self.temp_file = "speech_temp.wav"
            self.save_cmd = ['espeak', '-w']
            self.play_cmd = ['aplay']
        else:
            # Fallback/Generic
            self.temp_file = "speech_temp.wav"
            self.save_cmd = None
            self.play_cmd = None
            print(f"[Speech] Warning: Unsupported platform {self.platform}. Speech may not work.")

        self.current_sound = None
        self.sound_array = None
        self.start_time = 0
        self.duration = 0

    def _speak_internal(self, text):
        if not self.save_cmd or not self.play_cmd:
            print("[Speech] Error: Speech commands not configured for this platform.")
            return

        try:
            with self._lock:
                self.is_talking = True
                self.full_text = text
                print(f"[Speech] Processing text ({self.platform}): {text}")
                
                # 1. Save TTS to file
                try:
                    # Build command: [cmd, arg, filename, text]
                    cmd = self.save_cmd + [self.temp_file, text]
                    subprocess.run(cmd, check=True)
                    # Ensure file is flushed to disk
                    time.sleep(0.2) 
                    print(f"[Speech] Saved to {self.temp_file}")
                except Exception as tts_e:
                    print(f"[Speech] Generation error: {tts_e}")
                    return

                # 2. Playback
                try:
                    # Estimate duration for animation
                    self.duration = len(self.full_text.split()) / 3.0
                    
                    if os.path.exists(self.temp_file):
                        size = os.path.getsize(self.temp_file)
                        print(f"[Speech] File {self.temp_file} size: {size} bytes")
                        if size == 0:
                            print("[Speech] Error: Audio file is empty!")
                            return
                    else:
                        print(f"[Speech] Error: File {self.temp_file} not found!")
                        return

                    abs_load_file = os.path.abspath(self.temp_file)
                    print(f"[Speech] Executing: {' '.join(self.play_cmd)} {abs_load_file}")
                    
                    # Use subprocess.run for blocking playback
                    result = subprocess.run(
                        self.play_cmd + [abs_load_file], 
                        stdout=subprocess.DEVNULL, 
                        stderr=subprocess.DEVNULL
                    )
                    
                    self.start_time = time.time()
                    print(f"[Speech] Playback finished with exit code: {result.returncode}")
                    
                except Exception as e:
                    print(f"[Speech] Playback error: {e}")
        except Exception as e:
            print(f"[Speech] Unexpected system error: {e}")
        finally:
            self.is_talking = False
            self.current_word = ""

    def say(self, text):
        if self.is_talking:
            return
        threading.Thread(target=self._speak_internal, args=(text,), daemon=True).start()

    def update(self):
        if not self.is_talking or self.sound_array is None:
            self.face.set_mouth(MOUTH_CLOSED)
            return

        elapsed = time.time() - self.start_time
        if elapsed > self.duration:
            self.is_talking = False
            self.face.set_mouth(MOUTH_CLOSED)
            return

        sample_rate = pygame.mixer.get_init()[0]
        index = int(elapsed * sample_rate)
        
        if index < len(self.sound_array):
            sample = self.sound_array[index]
            volume = np.abs(sample).mean() if isinstance(sample, np.ndarray) else abs(sample)
            
            if volume > 10000: 
                self.face.set_mouth(MOUTH_OPEN)
            elif volume > 2000:
                self.face.set_mouth(MOUTH_MID)
            else:
                self.face.set_mouth(MOUTH_CLOSED)

        words = self.full_text.split()
        if words:
            word_idx = int((elapsed / self.duration) * len(words))
            if word_idx < len(words):
                self.current_word = words[word_idx]
            else:
                self.current_word = ""

class RobotFace:
    def __init__(self):
        self.mouth_state = MOUTH_CLOSED
        self.eye_blink = False
        self.blink_timer = 0
        self.eye_offset = 0

    def set_mouth(self, state):
        self.mouth_state = state

    def update(self, is_speaking=False):
        self.blink_timer += 1
        if self.blink_timer > 200:
            self.eye_blink = True
            if self.blink_timer > 210:
                self.eye_blink = False
                self.blink_timer = 0
        
        if is_speaking:
            self.eye_offset = 0
        else:
            if random.random() < EYE_IDLE_CHANCE:
                self.eye_offset = random.choice([-1, 0, 1])

    def draw(self, screen):
        w, h = screen.get_size()
        cx, cy = w // 2, h // 2
        scale = min(w, h) // 10 
        offset_px = self.eye_offset * scale * EYE_LOOK_DISTANCE
        eye_w = scale * 2
        eye_h = scale * 2 if not self.eye_blink else scale // 4
        eye_y_offset = scale if self.eye_blink else 0
        pygame.draw.rect(screen, COLOR_EYE, (cx - scale * 3 + offset_px, cy - scale * 2 + eye_y_offset, eye_w, eye_h))
        pygame.draw.rect(screen, COLOR_EYE, (cx + scale + offset_px, cy - scale * 2 + eye_y_offset, eye_w, eye_h))
        mouth_x = cx - scale * 2
        mouth_y = cy + scale
        mouth_w = scale * 4
        if self.mouth_state == MOUTH_CLOSED:
            mouth_h = scale // 2
        elif self.mouth_state == MOUTH_MID:
            mouth_h = scale * 2
        else:
            mouth_h = scale * 4
        pygame.draw.rect(screen, COLOR_MOUTH, (mouth_x, mouth_y, mouth_w, mouth_h))

class RobotFaceApp:
    def __init__(self):
        pygame.init()
        self.screen = pygame.display.set_mode((800, 600), pygame.RESIZABLE)
        pygame.display.set_caption("Robot Face")
        self.clock = pygame.time.Clock()
        self.face = RobotFace()
        self.speech = SpeechManager(self.face)
        self.running = True

    def handle_events(self):
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                self.running = False
            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_f:
                    pygame.display.toggle_fullscreen()

    def update(self):
        self.face.update(is_speaking=self.speech.is_talking)
        self.speech.update()

    def draw(self):
        self.screen.fill(COLOR_BG)
        self.face.draw(self.screen)
        if self.speech.is_talking:
            font = pygame.font.SysFont('monospace', 40, bold=True)
            text_surface = font.render(self.speech.current_word, True, COLOR_EYE)
            text_rect = text_surface.get_rect(center=(self.screen.get_width() // 2, self.screen.get_height() - 80))
            self.screen.blit(text_surface, text_rect)
        pygame.display.flip()

    def run_once(self):
        self.handle_events()
        self.update()
        self.draw()
        self.clock.tick(60)

    def stop(self):
        pygame.quit()
